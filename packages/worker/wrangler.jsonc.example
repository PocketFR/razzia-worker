{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "razzia",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",

  // La SPA renvoie index.html pour tout chemin inconnu, donc sans cette liste
  // /ws et /spotify n'atteindraient JAMAIS le Worker : les assets répondraient
  // avant.
  //
  // Le branding livré vit dans packages/web/public/branding, et sert de
  // repli : le frontend va chercher /branding/theme.json au démarrage, et le
  // Worker répond à partir de la base dès que l'écran de branding a servi.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/ws",
      "/api/*",
      "/spotify/*",
      "/deezer/*",
      "/soundtrack/*",
      // Ces deux-là ONT un équivalent statique, et c'est le piège : sans
      // cette ligne les assets répondraient d'abord, et le branding
      // enregistré en base ne serait jamais servi.
      "/branding/theme.json",
      "/branding/asset/*"
    ]
  },

  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },

  // new_sqlite_classes et non new_classes : le stockage SQLite est la seule
  // variante de Durable Object disponible au plan Free, et la seule qui
  // expose le KV synchrone dont dépend la persistance d'état.
  // LA LISTE DES MIGRATIONS DÉCRIT L'HISTOIRE D'UNE INSTALLATION, PAS LE CODE.
  //
  // Cloudflare applique les tags qu'une installation n'a pas encore vus. Copier
  // la liste d'une installation vers une autre lui fait donc rejouer des
  // migrations qui ne la concernent pas — et `deleted_classes` DÉTRUIT
  // l'espace de noms et tout son stockage, sans retour.
  //
  // C'est arrivé : une configuration dérivée d'une instance qui avait été
  // purgée a emporté la seconde avec elle. Une nouvelle installation n'a besoin
  // que de v1 ; n'ajoutez un tag qu'en sachant ce qu'il fera à CETTE
  // installation-là.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "razzia",
      "database_id": "REMPLACER_APRES_wrangler_d1_create"
    }
  ],

  // L'adresse publique. Par défaut celle que Cloudflare fournit gratuitement,
  // <worker>.<compte>.workers.dev, qui ne demande aucun domaine à soi et
  // suffit parfaitement à des soirées entre amis.
  //
  // Pour un nom à vous, relancer le script avec DOMAINE=quiz.exemple.fr : il
  // remplace cette ligne par une route de domaine dédié. Le domaine doit être
  // géré par Cloudflare — c'est ce qui permet d'y attacher un Worker sans
  // toucher au DNS à la main.
  "workers_dev": true,

  // Quotidien, à 4 h UTC : il ne ramasse que des lignes vieilles d'un jour,
  // l'heure exacte n'a donc aucune importance.
  "triggers": { "crons": ["0 4 * * *"] },

  "observability": { "enabled": true }
}
